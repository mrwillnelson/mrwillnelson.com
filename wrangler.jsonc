{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mrwillnelson-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/talkstories",
      "/talkstories/*",
      "/wills-brand",
      "/wills-brand/*",
      "/_private/*"
    ]
  },
  "routes": [
    {
      "pattern": "mrwillnelson.com",
      "custom_domain": true
    },
    {
      "pattern": "www.mrwillnelson.com",
      "custom_domain": true
    }
  ]
}
